{
  "name": "monorepo",
  "version": "0.1.2",
  "description": "three-d-modules",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "push": "./scripts/gitpush.sh",
    "build": "./Dockerfiles/build.sh",
    "build:server": "./Dockerfiles/build.server.sh",
    "docker:run": "./Dockerfiles/dockerRun.sh",
    "format": "pnpm prettier --write .",
    "format:target": "pnpm prettier --write",
    "format:check": "pnpm exec prettier --check .",
    "lint": "pnpm exec eslint . --ext .ts,.tsx",
    "logs": "git log -n 10 --oneline",
    "test": "./scripts/test.sh",
    "docker-compose:buildings": "docker-compose -f docker-compose.prod-buildings.yml down -v && docker-compose -f docker-compose.prod-buildings.yml up --build -d",
    "compose": "./Dockerfiles/compose.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
